<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.textview.MaterialTextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_episode_item"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center"
    android:stateListAnimator="@animator/scale_focus"
    android:nextFocusUp="@id/episode"
    android:nextFocusDown="@id/quick"
    android:textColor="@color/selector_episode_text"
    android:textSize="16sp"
    tools:text="11" />
