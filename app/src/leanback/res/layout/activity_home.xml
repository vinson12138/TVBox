<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_logo" />

        <com.fongmi.android.tv.ui.custom.CustomTitleView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:focusable="false"
            android:nextFocusRight="@id/actionSetting"
            android:nextFocusDown="@id/nav"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/actionSetting"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/selector_btn_round"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/title"
            android:nextFocusDown="@id/recycler"
            android:padding="4dp"
            android:src="@drawable/ic_home_setting"
            android:tint="@color/selector_nav_text" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/network"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/home_network_online"
            android:focusable="false"
            android:src="@drawable/ic_home_network"
            android:tint="@color/white" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/white"
            android:textSize="22sp"
            tools:text="09:20" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/nav"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nextFocusRight="@id/recycler"
            android:paddingEnd="6dp"
            app:focusOutFront="true"
            tools:listitem="@layout/adapter_home_nav" />

        <com.fongmi.android.tv.ui.custom.ProgressLayout
            android:id="@+id/progressLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nextFocusLeft="@id/nav"
                android:nextFocusUp="@id/actionSetting"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                app:focusOutEnd="true"
                app:focusOutFront="true" />

            <include layout="@layout/view_home_search" />

            <include layout="@layout/view_home_keep" />

        </com.fongmi.android.tv.ui.custom.ProgressLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
